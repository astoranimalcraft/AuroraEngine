@PACKAGE_INIT@

# NexiumEngineConfig.cmake — generated from NexiumEngineConfig.cmake.in.
#
# Lets a downstream project write:
#
#     find_package(NexiumEngine REQUIRED)
#     target_link_libraries(my_game PRIVATE NexiumEngine::nexiumengine)
#
# The exported target carries the include directories and the DirectX link
# libraries, so nothing else has to be spelled out by the consumer.

include("${CMAKE_CURRENT_LIST_DIR}/NexiumEngineTargets.cmake")

check_required_components(NexiumEngine)
